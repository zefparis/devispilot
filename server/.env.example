# ── DevisPilot · API (server/) ─────────────────────────────────
# Copier en .env sur x3 et adapter. Ne jamais versionner .env.

# Port d'écoute dans le conteneur (mappé sur 127.0.0.1:API_PORT par Compose)
PORT=3400

# Origines frontend autorisées en CORS, séparées par des virgules.
# Ex. : https://devispilot.vercel.app,https://app.votre-domaine.fr
CORS_ORIGINS=https://devispilot.vercel.app

# Origine publique de l'API (base URL Better Auth + cookie Secure si https)
BASE_URL=https://api.votre-domaine.fr

# Secret session : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_secret_aleatoire_32_octets_minimum

# Chaîne PostgreSQL (fournie par docker-compose en pratique)
DATABASE_URL=postgres://devispilot:CHANGE_ME@db:5432/devispilot

# Inscription publique : false en production tant que la vérification
# d'email n'est pas opérationnelle.
SIGNUP_ENABLED=false

# cloudflared sur l'hôte → X-Forwarded-* fiables. Laisser true.
TRUST_PROXY=true

# Forcer le cookie Secure hors https (auto si BASE_URL https).
COOKIE_SECURE=true

LOG_LEVEL=info

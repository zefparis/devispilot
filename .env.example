# ── DevisPilot · configuration ─────────────────────────────────
# Copier en .env et remplacer les valeurs. Ne jamais versionner .env.
# Ce fichier couvre deux usages : le build frontend (Vercel) et la
# stack Docker Compose (X3, voir DEPLOIEMENT-X3.md).

# ── Frontend (Vercel) ──────────────────────────────────────────
# URL publique de l'API (backend X3 derrière le tunnel Cloudflare).
# Exemple factice — remplacer par le domaine réel du tunnel.
# Vide/absent = front et API sur la même origine (auto-hébergement).
VITE_API_URL=https://api.votre-domaine.fr

# ── Stack Docker Compose (X3) ──────────────────────────────────
# PostgreSQL (reste privé au réseau Docker)
POSTGRES_DB=devispilot
POSTGRES_USER=devispilot
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_long_et_aleatoire

# Secret de session Better Auth : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_secret_aleatoire_32_octets_minimum

# Origine publique de l'API servie (ex. https://api.votre-domaine.fr)
# - détermine le cookie Secure (https → Secure)
# - et les origines de confiance Better Auth / CSRF.
BASE_URL=http://127.0.0.1:3400

# Origines frontend autorisées (CORS + cookies cross-site), séparées
# par des virgules. Ex. : https://devispilot.vercel.app,https://app.votre-domaine.fr
# Vide = front servi par l'API (même origine, pas de CORS nécessaire).
CORS_ORIGINS=

# Port hôte (loopback uniquement) où cloudflared vient chercher l'app.
# Sur X3, 3400 est libre ; vérifier avec : ss -tln | grep 3400
API_PORT=3400

# Inscription publique : false en production tant que la vérification
# d'email n'est pas branchée. Créer les comptes pilotes à la main
# (voir DEPLOIEMENT-X3.md) ou passer temporairement à true.
SIGNUP_ENABLED=false

# true derrière cloudflared (en-têtes X-Forwarded-* honorés).
TRUST_PROXY=true

LOG_LEVEL=info

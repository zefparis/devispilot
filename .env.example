# ── DevisPilot · configuration ─────────────────────────────────
# Copier en .env et remplacer les valeurs. Ne jamais versionner .env.

# PostgreSQL (reste privé au réseau Docker)
POSTGRES_DB=devispilot
POSTGRES_USER=devispilot
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_long_et_aleatoire

# Secret de session Better Auth : openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_secret_aleatoire_32_octets_minimum

# Origine publique servie (ex. https://devispilot.mondomaine.fr)
# - détermine le cookie Secure (https → Secure)
# - et les origines de confiance Better Auth / CSRF.
BASE_URL=http://127.0.0.1:3400

# Port hôte (loopback uniquement) où cloudflared vient chercher l'app.
# Sur X3, 3400 est libre ; vérifier avec : ss -tlnp | grep 3400
API_PORT=3400

# Inscription publique : false en production tant que la vérification
# d'email n'est pas branchée. Créer les comptes pilotes à la main
# (voir DEPLOIEMENT-X3.md) ou passer temporairement à true.
SIGNUP_ENABLED=false

# Laisser false : pas de reverse proxy HTTP intermédiaire devant l'API,
# cloudflared s'y connecte directement sur 127.0.0.1.
TRUST_PROXY=false

LOG_LEVEL=info
